{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"noEmit": true,
		"emitDeclarationOnly": false,
		"allowImportingTsExtensions": true
	},
	"include": ["scripts", "packages/*/src", "packages/*/scripts", "packages/*/native", "packages/*/test", "packages/*/tests", "packages/browser-relay/extension"],
	"exclude": ["node_modules"]
}
