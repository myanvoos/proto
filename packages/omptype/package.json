{
  "type": "module",
  "name": "@oh-my-pi/omptype",
  "version": "18.0.4",
  "description": "ArkType-compatible runtime schema validation with lazy JIT compilation",
  "homepage": "https://github.com/myanvoos/proto",
  "author": "Stencil Labs, Inc.",
  "license": "MIT",
  "keywords": [
    "schema",
    "validation",
    "arktype",
    "jit"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "bench": "bun bench/bench.ts"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.0",
    "@types/bun": "catalog:"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  }
}
