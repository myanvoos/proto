{
  "type": "module",
  "name": "@oh-my-pi/pi-agent-core",
  "version": "18.0.4",
  "description": "General-purpose agent with transport abstraction, state management, and attachment support",
  "homepage": "https://github.com/myanvoos/proto",
  "author": "Stencil Labs, Inc.",
  "contributors": [
    "Mario Zechner"
  ],
  "license": "MIT",
  "keywords": [
    "ai",
    "agent",
    "llm",
    "transport",
    "state-management"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write ."
  },
  "dependencies": {
    "@oh-my-pi/pi-ai": "catalog:",
    "@oh-my-pi/pi-catalog": "catalog:",
    "@oh-my-pi/pi-natives": "catalog:",
    "@oh-my-pi/pi-utils": "catalog:",
    "@opentelemetry/api": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./compaction": {
      "types": "./src/compaction/index.ts",
      "import": "./src/compaction/index.ts"
    },
    "./compaction/*": {
      "types": "./src/compaction/*.ts",
      "import": "./src/compaction/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  }
}
