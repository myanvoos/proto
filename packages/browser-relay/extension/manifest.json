{
	"manifest_version": 3,
	"name": "PROTO Browser Relay",
	"version": "0.1.0",
	"description": "Lets the proto coding agent drive your existing tabs through a local CDP relay.",
	"permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
	"background": {
		"service_worker": "background.js"
	},
	"options_page": "options.html",
	"action": {
		"default_title": "PROTO Browser Relay (click for settings)"
	}
}
